# ── Frontend (safe to expose: anon key is public, protected by Row Level Security) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side ONLY: configure as Supabase Edge Function secrets, never VITE_ or Vercel ──
# Default provider: Groq OpenAI-compatible API + openai/gpt-oss-20b.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_RATE_LIMIT_PER_HOUR=30
ALLOWED_ORIGIN=*
