# ── Frontend (safe to expose: anon key is public, protected by Row Level Security) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side ONLY: set as Supabase Edge Function secrets, NEVER prefix with VITE_ ──
# supabase secrets set AI_API_KEY=sk-... AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_HOUR=30
ALLOWED_ORIGIN=*
